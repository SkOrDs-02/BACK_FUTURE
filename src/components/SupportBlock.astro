---
import { SITE } from "../config/site";
import { SUPPORT_PATH, hasSupportJar } from "../lib/support";

// Без банки блок не рендериться зовсім: сіра кнопка «незабаром» на кожній
// сторінці виглядала б як недороблена.
const show = hasSupportJar();
---

{
  show && (
    <aside class="container-prose border-ink-100 from-accent-50 dark:from-accent-900/30 dark:to-ink-800 mt-16 rounded-3xl border bg-gradient-to-br to-white p-7 sm:p-10 dark:border-[color:var(--card-edge)]">
      <h2 class="font-display text-ink-900 text-2xl font-extrabold sm:text-3xl">
        Сподобалось? Підтримай проєкт
      </h2>
      <p class="text-ink-700 mt-2">
        {SITE.name} робить одна людина у вільний час. Якщо хочеш, щоб з'являлось більше фактів,
        пригости автора кавою.
      </p>

      <div class="mt-5 flex flex-wrap gap-3" id="support-buttons">
        <a class="btn" href={SUPPORT_PATH} data-support-provider="monobank">
          Підтримати проєкт
        </a>
      </div>
    </aside>
  )
}

<script>
  import { EVENTS, track } from "../lib/analytics";

  document
    .querySelectorAll<HTMLAnchorElement>("#support-buttons [data-support-provider]")
    .forEach((a) => {
      a.addEventListener(
        "click",
        () => {
          track(EVENTS.supportClicked, { provider: a.dataset.supportProvider ?? null });
        },
        { passive: true },
      );
    });
</script>
